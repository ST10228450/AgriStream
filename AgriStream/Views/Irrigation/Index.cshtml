@{
    ViewData["Title"] = "Irrigation Control";
}

<div class="container-fluid">

    <div class="section-heading">
        <div>
            <h2>Irrigation Control</h2>
            <p>Submit and manage irrigation requests.</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="panel">

        <h3>New Irrigation Request</h3>

        <p class="panel-subtitle">
            Submit an irrigation command for a selected farm and field.
        </p>

        <form asp-controller="Irrigation"
              asp-action="Trigger"
              method="post">

            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">Farm ID</label>

                <input type="text"
                       name="farmId"
                       class="form-control"
                       required />
            </div>

            <div class="mb-3">
                <label class="form-label">Field ID</label>

                <input type="text"
                       name="fieldId"
                       class="form-control"
                       required />
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Irrigation Duration (Minutes)
                </label>

                <input type="number"
                       name="durationMinutes"
                       class="form-control"
                       min="1"
                       max="120"
                       required />
            </div>

            <button type="submit" class="btn-primary">
                Submit Irrigation Request
            </button>

        </form>

    </div>

</div>
